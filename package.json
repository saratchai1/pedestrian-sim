{
  "name": "evac-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run test:model-tools",
    "test:model-tools": "python -m unittest discover -s tools/model-preprocess -p \"test_*.py\"",
    "model": "node tools/model-preprocess/run.mjs",
    "model:inspect": "node tools/model-preprocess/run.mjs --inspect-only",
    "check:artifacts": "node scripts/check-large-artifacts.mjs"
  },
  "dependencies": {
    "@recast-navigation/three": "0.43.1",
    "recast-navigation": "0.43.1",
    "three": "0.186.0",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
